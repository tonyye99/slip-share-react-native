# Same Supabase project as the slip-share web app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The published website (see README), so the phone app can send friend links.
# EXPO_PUBLIC_WEB_URL=https://your-site.expo.app

# PostHog usage stats and error reports (Project API key, starts with phc_).
# Leave it out and nothing is sent. Host: https://eu.i.posthog.com or https://us.i.posthog.com.
# EXPO_PUBLIC_POSTHOG_API_KEY=phc_your-key
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
